#!/usr/bin/env bash
set -euo pipefail

source_link="$HOME/dedicatory.txt"
allowed_dir="$HOME/dropbox/box/dedicatory"

if [[ ! -L "$source_link" ]]; then
   echo "Error: '$source_link' must exist and be a symbolic link." >&2
   exit 1
fi

if [[ ! -e "$source_link" ]]; then
   echo "Error: '$source_link' is a broken symbolic link." >&2
   exit 1
fi

if [[ ! -d "$allowed_dir" ]]; then
   echo "Error: '$allowed_dir' does not exist." >&2
   exit 1
fi

resolved_allowed_dir="$(readlink -f -- "$allowed_dir")"
resolved_target="$(readlink -f -- "$source_link")"

case "$resolved_target" in
   "$resolved_allowed_dir"/*)
      ;;
   *)
      echo "Error: '$source_link' must point inside '$allowed_dir' (currently resolves to '$resolved_target')." >&2
      exit 1
      ;;
esac

raw_target="$(readlink -- "$source_link")"
if [[ "$raw_target" == /* ]]; then
   link_target="$raw_target"
else
   link_target="$resolved_target"
fi

current_dir="${PWD%/}"
if [[ -z "$current_dir" || "$(cygpath -am -- "$current_dir")" =~ ^[A-Za-z]:/$ ]]; then
   echo "Error: cannot create dedicatory symlink for a filesystem root." >&2
   exit 1
fi

dest_link="${current_dir}.dedicatory"

if [[ -e "$dest_link" && ! -L "$dest_link" ]]; then
   echo "Error: '$dest_link' already exists and is not a symbolic link." >&2
   exit 1
fi

MSYS=winsymlinks:nativestrict ln -sfn -- "$link_target" "$dest_link"
echo "Updated '$dest_link' -> '$link_target'"
