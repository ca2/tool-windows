#!/usr/bin/env bash
# Repair Git symlink placeholders, including initialized submodules.
set -u

usage() {
  cat <<'USAGE'
Usage: repair-git-symlinks [--apply] [--root PATH]
Default: check the current repository without changing files.
Run repair-git-symlinks --apply to repair. --root PATH selects another repository.
Repairs unchanged placeholders and broken links with an existing indexed target
from Git. No target paths are guessed.
Missing or ambiguous targets are reported without changing their links.
USAGE
}

apply=0
root=.
while (( $# )); do
  case "$1" in
    --apply) apply=1; shift ;;
    --root)
      if (( $# < 2 )); then echo 'Missing value for --root' >&2; exit 2; fi
      root=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
requested_root=$root
root=$(git -C "$root" rev-parse --show-toplevel) || exit 1
# Git for Windows can return a drive path that Bash file tests cannot use.
if command -v cygpath >/dev/null 2>&1; then
  root=$(cygpath -u "$root") || exit 1
fi
repaired=0 would_repair=0 skipped=0 failed=0 repos=0 broken=0

repair_broken_link() {
  local full=$1 repo=$2 oid=$3
  local old indexed candidate= entry replacement backup
  old=$(readlink -- "$full") || { ((failed+=1)); return; }
  indexed=$(git -C "$repo" cat-file blob "$oid") || { ((failed+=1)); return; }
  # Prefer the exact indexed destination if the working link was changed.
  if [[ "$indexed" = /* || "$indexed" =~ ^[A-Za-z]: ]]; then
    entry=$indexed
  else
    entry="${full%/*}/$indexed"
  fi
  if [[ -e "$entry" ]]; then
    candidate=$entry
  else
    candidate=
  fi
  if [[ -z "$candidate" ]]; then
    printf 'UNRESOLVED (target not found): %s -> %s\n' "$full" "$old"
    ((broken+=1))
    return
  fi
  replacement=$(realpath --relative-to="${full%/*}" -- "$candidate") || { ((failed+=1)); return; }
  if (( !apply )); then
    printf 'WOULD REPAIR BROKEN LINK: %s -> %s (was %s)\n' "$full" "$replacement" "$old"
    ((would_repair+=1))
    return
  fi
  backup=$(mktemp "${full}.symlink-backup.XXXXXXXX") || { ((failed+=1)); return; }
  if ! mv -f -- "$full" "$backup"; then
    rm -f -- "$backup"
    ((failed+=1))
    return
  fi
  # MSYS must create a native symlink rather than copying its destination.
  if MSYS=winsymlinks:nativestrict ln -s -- "$replacement" "$full" && [[ -L "$full" && -e "$full" ]]; then
    if rm -f -- "$backup"; then
      printf 'REPAIRED BROKEN LINK: %s -> %s\n' "$full" "$replacement"
      ((repaired+=1))
    else
      printf 'ERROR removing backup: %s\n' "$backup" >&2
      ((failed+=1))
    fi
  else
    if [[ -L "$full" ]]; then rm -- "$full"; fi
    if [[ ! -e "$full" && ! -L "$full" ]] && mv -- "$backup" "$full"; then
      printf 'ERROR repair failed; original link restored: %s\n' "$full" >&2
    else
      printf 'ERROR restore backup manually: %s\n' "$backup" >&2
    fi
    ((failed+=1))
  fi
}

repair_repo() {
  local repo=$1
  local record mode oid stage path full actual backup listing
  ((repos+=1))
  printf '\nRepository: %s\n' "$repo"

  # Materialize the listing so a Git failure cannot silently look like success.
  listing=$(mktemp) || { ((failed+=1)); return; }
  if ! git -C "$repo" ls-files --stage -z > "$listing"; then
    rm -f -- "$listing"
    ((failed+=1))
    return
  fi
  if (( apply )); then
    if ! git -C "$repo" config --local core.symlinks true; then
      printf 'ERROR configuring core.symlinks: %s\n' "$repo" >&2
      rm -f -- "$listing"
      ((failed+=1))
      return
    fi
  fi

  while IFS= read -r -d '' record; do
    [[ "$record" == *$'\t'* ]] || continue
    path=${record#*$'\t'}
    record=${record%%$'\t'*}
    read -r mode oid stage <<< "$record"
    full="$repo/$path"

    if [[ "$stage" != 0 ]]; then
      printf 'SKIP unmerged index entry: %s\n' "$full"
      ((skipped+=1))
      continue
    fi
    case "$mode" in
      160000)
        if [[ -d "$full" && -e "$full/.git" ]]; then
          repair_repo "$full"
        else
          printf 'SKIP uninitialized submodule: %s\n' "$full"
          ((skipped+=1))
        fi
        ;;
      120000)
        if [[ -L "$full" ]]; then
          if [[ ! -e "$full" ]]; then
            printf 'BROKEN LINK: %s -> %s\n' "$full" "$(readlink -- "$full")"
            repair_broken_link "$full" "$repo" "$oid"
          fi
          continue
        fi
        if [[ ! -f "$full" ]]; then
          printf 'SKIP missing or non-file: %s\n' "$full"
          ((skipped+=1))
          continue
        fi
        actual=$(git -C "$repo" hash-object --no-filters -- "$path") || {
          printf 'SKIP cannot hash: %s\n' "$full"
          ((skipped+=1))
          continue
        }
        if [[ "$actual" != "$oid" ]]; then
          printf 'SKIP modified placeholder: %s\n' "$full"
          ((skipped+=1))
          continue
        fi
        if (( !apply )); then
          printf 'WOULD REPAIR: %s\n' "$full"
          ((would_repair+=1))
          continue
        fi
        backup=$(mktemp "${full}.symlink-backup.XXXXXXXX") || {
          printf 'ERROR creating backup: %s\n' "$full" >&2
          ((failed+=1))
          continue
        }
        if ! mv -f -- "$full" "$backup"; then
          rm -f -- "$backup"
          printf 'ERROR backing up: %s\n' "$full" >&2
          ((failed+=1))
          continue
        fi
        if git --literal-pathspecs -C "$repo" -c core.symlinks=true restore --worktree -- "$path" && [[ -L "$full" ]]; then
          if rm -f -- "$backup"; then
            printf 'REPAIRED: %s\n' "$full"
            ((repaired+=1))
          else
            printf 'ERROR repaired, but backup cleanup failed: %s\n' "$backup" >&2
            ((failed+=1))
          fi
        else
          if [[ -L "$full" ]]; then
            printf 'ERROR unexpected symlink; backup retained: %s\n' "$backup" >&2
          elif [[ ! -e "$full" || -f "$full" ]]; then
            if rm -f -- "$full" && mv -- "$backup" "$full"; then
              printf 'ERROR repair failed, placeholder restored: %s\n' "$full" >&2
            else
              printf 'ERROR restore backup manually: %s\n' "$backup" >&2
            fi
          else
            printf 'ERROR unexpected path type; backup retained: %s\n' "$backup" >&2
          fi
          ((failed+=1))
        fi
        ;;
    esac
  done < "$listing"
  rm -f -- "$listing"
}

repair_repo "$root"
printf '\nRepositories: %d | Repaired: %d | Would repair: %d | Skipped: %d | Failed: %d\n' \
  "$repos" "$repaired" "$would_repair" "$skipped" "$failed"
if (( broken > 0 )); then
  printf '\nATTENTION: %d symlink(s) point to missing or inaccessible targets.\n' "$broken"
  printf 'These targets are missing or ambiguous; restore the dependencies or correct these paths manually.\n'
fi
if (( failed > 0 )); then
  printf 'ERROR: some checks or repairs failed; review the messages above.\n'
elif (( !apply && would_repair > 0 )); then
  printf 'Repairs needed: %d symlink(s). Run:\n\n' "$would_repair"
  printf '  repair-git-symlinks --apply'
  if [[ "$requested_root" != . ]]; then
    printf ' --root %q' "$requested_root"
  fi
  printf '\n'
elif (( broken > 0 )); then
  printf 'Symlink check needs attention; review the broken links above.\n'
elif (( skipped > 0 )); then
  printf 'CHECK INCOMPLETE: %d item(s) skipped; review the messages above.\n' "$skipped"
elif (( apply && repaired > 0 )); then
  printf 'OK: all detected symlink repairs completed.\n'
else
  printf 'OK: no symlink repairs needed.\n'
fi
(( failed == 0 ))
