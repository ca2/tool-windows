#!/usr/bin/env bash

tool_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1

machine=$(uname -m) || exit 1
case "$machine" in
    x86_64|amd64) architecture=x64 ;;
    aarch64|arm64) architecture=arm64 ;;
    i[3-6]86|x86) architecture=x86 ;;
    *)
        printf 'Unsupported architecture: %s\n' "$machine" >&2
        exit 1
        ;;
esac

export PATH="$tool_dir/bin:$tool_dir/bin/$architecture:$PATH"

checkout=$tool_dir
while parent=$(git -C "$checkout" rev-parse --show-superproject-working-tree 2>/dev/null) && [[ -n "$parent" ]]; do
    checkout=$parent
done
origin=$(git -C "$checkout" config --get remote.origin.url 2>/dev/null)
case "$origin" in
    ssh://*|git+ssh://*|ssh+git://*)
        . "$tool_dir/bin/defer_ssh_agent"
        ;;
    *://*|[A-Za-z]:*|*/*:*|*\\*:*)
        ;;
    ?*:*)
        # SCP-style SSH URL, such as git@github.com:ca2/windows-simple.
        . "$tool_dir/bin/defer_ssh_agent"
        ;;
esac

exec bash -i
